generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AccessPointGroups {
  access_point_group_id   Int     @id @default(autoincrement())
  access_point_group_name String? @db.VarChar(150)
  schedule_id             Int?
  max_capacity            Int?
  allows_reservations     Boolean @default(false)
  outlet_id               Int?
}

model AccessPoints {
  access_point_id           Int      @id @default(autoincrement())
  access_point_sub_group_id Int?
  access_point_name         String?  @db.VarChar(150)
  products                  Json?
  product_cat               Json?
  activities                Json?
  active                    Boolean? @default(true)
  outlet_id                 Int?
  access_point_group_id     Int?
  typology_id               Int?
}

model EmailSettings {
  id             Int    @id @default(autoincrement()) @db.UnsignedInt
  reply_email    String @db.VarChar(255)
  reply_password String @db.VarChar(255)
  sending_server String @db.VarChar(255)
  sending_port   Int    @db.UnsignedInt
}

model EmailTemplates {
  email_template_id Int       @id @default(autoincrement())
  email_title1      String?   @db.VarChar(255)
  email_title2      String?   @db.VarChar(255)
  email_title3      String?   @db.VarChar(255)
  email_title4      String?   @db.VarChar(255)
  email_title5      String?   @db.VarChar(255)
  email_body1       String?   @db.Text
  email_body2       String?   @db.Text
  email_body3       String?   @db.Text
  email_body4       String?   @db.Text
  email_body5       String?   @db.Text
  created_at        DateTime? @default(now()) @db.Timestamp(0)
  created_by        Int?
  updated_at        DateTime? @default(now()) @db.Timestamp(0)
  updated_by        Int?
}

model FormTemplates {
  form_id                Int   @id @default(autoincrement())
  form_type              Int?  @db.TinyInt
  fields1                Json?
  fields2                Json?
  fields3                Json?
  fields4                Json?
  fields5                Json?
  available_activities   Json?
  available_products     Json?
  available_product_cats Json?
}

model GroupUsers {
  user_group_id Int   @id @default(autoincrement())
  user_id       Int
  perms         Json?
}

model Languages {
  lang_id         Int     @id @default(autoincrement())
  lang_name       String  @db.VarChar(50)
  lang_order      Int?
  lang_identifier String? @db.VarChar(2)
}

model Personalize {
  personalize_id   Int     @id @default(autoincrement())
  page_model       Int?
  primary_color    String? @db.VarChar(50)
  secondary_color  String? @db.VarChar(50)
  background_color String? @db.VarChar(50)
  foreground_color String? @db.VarChar(50)
  card_colors      Json?
  background_image String? @db.VarChar(255)
  logo             String? @db.VarChar(255)
  bar_text         String? @db.VarChar(255)
  bar_text_details String? @db.VarChar(255)
  icon_color       String? @db.VarChar(50)
  card_text_font   String? @db.VarChar(45)
  card_text_color  String? @db.VarChar(45)
  card_text_size   String? @db.VarChar(45)
}

model Preparation {
  preparation_id       Int     @id @default(autoincrement())
  preparation_group_id Int?
  preparation_name1    String? @db.VarChar(150)
  preparation_name2    String? @db.VarChar(150)
  preparation_name3    String? @db.VarChar(150)
  preparation_name4    String? @db.VarChar(150)
  preparation_name5    String? @db.VarChar(150)
}

model PreparationGroups {
  preparation_group_id   Int     @id @default(autoincrement())
  preparation_group_name String? @db.VarChar(150)
}

model Users {
  user_id    Int       @id @default(autoincrement())
  username   String    @db.VarChar(100)
  created_at DateTime? @default(now()) @db.DateTime(0)
  last_login DateTime? @db.DateTime(0)
  password   String    @db.VarChar(255)
  type       Int?      @db.TinyInt
}

model Users_FO {
  id                     Int       @id @default(autoincrement()) @db.UnsignedInt
  email                  String?   @unique(map: "uq_users_email") @db.VarChar(255)
  access_code            String?   @unique(map: "uq_users_access_code") @db.VarChar(255)
  created_at             DateTime  @default(now()) @db.Timestamp(0)
  updated_at             DateTime  @default(now()) @db.Timestamp(0)
  access_code_expiration DateTime? @db.DateTime(0)
  password               String?   @db.VarChar(255)
  session_token          String?   @unique(map: "session_token") @db.VarChar(255)
  session_expires_at     DateTime? @db.DateTime(0)
  account_duration       Int       @default(172800)
}

model chatbotsStay {
  propertyID         Int      @id
  active             Boolean  @default(false)
  provider           String?  @db.Text
  hijiffyToken       String?  @db.Text
  hijiffyCampaign    String?  @db.Text
  whatsappToken      String?  @db.Text
  whatsappPhoneID    String?  @db.Text
  preCheckinEnabled  Boolean? @default(false)
  checkinEnabled     Boolean? @default(false)
  checkinDelay       Int?     @default(0)
  preCheckoutEnabled Boolean? @default(false)
  preCheckoutDelay   Int?     @default(0)
  checkoutEnabled    Boolean? @default(false)
  checkoutDelay      Int?     @default(0)
}

model myStayDetails {
  recordID               Int       @id @default(autoincrement())
  requestDate            DateTime  @db.DateTime(0)
  propertyTag            String    @db.VarChar(255)
  protelMpeHotel         String    @db.VarChar(255)
  protelReservationID    String    @db.VarChar(255)
  protelRoomID           String    @db.VarChar(255)
  protelGuestID          String    @db.VarChar(255)
  protelGuestEmail       String?   @db.VarChar(255)
  protelGuestPhone       String?   @db.VarChar(32)
  protelValidFrom        DateTime  @db.DateTime(0)
  protelValidUntil       DateTime  @db.DateTime(0)
  control                String    @db.VarChar(1)
  reponseToken           String?   @db.VarChar(255)
  reponseURL             String?   @db.VarChar(255)
  protelBookingID        String    @db.VarChar(255)
  protelRoomTypeID       String    @db.VarChar(255)
  responseDate           DateTime? @db.DateTime(0)
  vatNo                  String?   @db.VarChar(255)
  child                  Int       @default(0)
  adult                  Int       @default(1)
  country                String    @db.VarChar(255)
  city                   String    @db.VarChar(255)
  postalCode             String?   @db.VarChar(20)
  nationality            String    @db.VarChar(255)
  birthCountry           String    @db.VarChar(255)
  birthDate              DateTime  @db.DateTime(0)
  identificationDocument String    @db.VarChar(255)
  documentIssueDate      DateTime  @db.DateTime(0)
  documentExpirationDate DateTime  @db.DateTime(0)
  Resend                 String    @db.VarChar(1)
  ResendDate             DateTime  @db.DateTime(0)
  protelSalutation       String?   @db.VarChar(50)
  protelGuestFirstName   String?   @db.VarChar(255)
  protelGuestLastName    String?   @db.VarChar(255)
  protelCountryID        Int?
  protelAddress          String?   @db.VarChar(255)
  protelGuestMobilePhone String?   @db.VarChar(32)
  protelDocType          String?   @db.VarChar(100)
  protelProfileType      String?   @db.VarChar(100)
  preCheckinControl      String    @default("N") @db.VarChar(1)
  checkinControl         String    @default("N") @db.VarChar(1)
}

model schedules {
  schedule_id   Int   @id @default(autoincrement())
  schedule_json Json
  slotDuration  Int   @default(30)
  exceptions    Json?
}

model Areas {
  area_id              Int       @id @default(autoincrement())
  area_name1           String?   @db.VarChar(150)
  area_name2           String?   @db.VarChar(150)
  area_name3           String?   @db.VarChar(150)
  area_name4           String?   @db.VarChar(150)
  area_name5           String?   @db.VarChar(150)
  visible              Boolean?  @default(true)
  area_icon            String?   @db.VarChar(255)
  area_card_background String?   @db.VarChar(255)
  Outlets              Outlets[]
}

model Menus {
  menu_id              Int        @id @default(autoincrement())
  outlet_id            Int?
  menu_name1           String?    @db.VarChar(150)
  menu_name2           String?    @db.VarChar(150)
  menu_name3           String?    @db.VarChar(150)
  menu_name4           String?    @db.VarChar(150)
  menu_name5           String?    @db.VarChar(150)
  visible              Boolean?   @default(true)
  menu_icon            String?    @db.VarChar(255)
  menu_card_background String?    @db.VarChar(255)
  has_submenus         Boolean?   @default(true)
  Outlets              Outlets?   @relation(fields: [outlet_id], references: [outlet_id], onDelete: NoAction, onUpdate: NoAction, map: "Menus_ibfk_1")
  Submenus             Submenus[]

  @@index([outlet_id], map: "outlet_id")
}

model Outlets {
  outlet_id              Int                      @id @default(autoincrement())
  area_id                Int?
  outlet_name1           String?                  @db.VarChar(150)
  outlet_name2           String?                  @db.VarChar(150)
  outlet_name3           String?                  @db.VarChar(150)
  outlet_name4           String?                  @db.VarChar(150)
  outlet_name5           String?                  @db.VarChar(150)
  visible                Boolean?                 @default(true)
  outlet_icon            String?                  @db.VarChar(255)
  outlet_card_background String?                  @db.VarChar(255)
  reservation            Int?
  order                  Int?
  schedule_id            Int?
  schedule_visible       Boolean                  @default(false)
  schedule_visible_part  Int?                     @default(2)
  access_points          Boolean                  @default(false)
  associate_schedule     Boolean                  @default(false)
  instant_order          Boolean                  @default(false)
  service_reservation    Boolean                  @default(false)
  takeaway_order         Boolean                  @default(false)
  reservation_item_id    Int?
  Menus                  Menus[]
  reservationItems       OutletReservationItems[]
  Areas                  Areas?                   @relation(fields: [area_id], references: [area_id], onDelete: NoAction, onUpdate: NoAction, map: "Outlets_ibfk_1")
  typologies             typologies[]

  @@index([area_id], map: "area_id")
}

model Submenus {
  submenu_id              Int      @id @default(autoincrement())
  menu_id                 Int?
  submenu_name1           String?  @db.VarChar(150)
  submenu_name2           String?  @db.VarChar(150)
  submenu_name3           String?  @db.VarChar(150)
  submenu_name4           String?  @db.VarChar(150)
  submenu_name5           String?  @db.VarChar(150)
  visible                 Boolean? @default(true)
  submenu_icon            String?  @db.VarChar(255)
  submenu_card_background String?  @db.VarChar(255)
  Menus                   Menus?   @relation(fields: [menu_id], references: [menu_id], onDelete: NoAction, onUpdate: NoAction, map: "Submenus_ibfk_1")

  @@index([menu_id], map: "menu_id")
}

model MenuSubmenuContent {
  content_id Int       @id @default(autoincrement())
  menu_id    Int?
  submenu_id Int?
  content    Json
  created_at DateTime? @default(now()) @db.Timestamp(0)
  created_by Int
  updated_at DateTime? @default(now()) @db.Timestamp(0)
  updated_by Int?
}

model ItemFamily {
  item_family_id   Int     @id @default(autoincrement())
  item_group_id    Int?
  item_family_name String? @db.VarChar(150)
}

model ItemGroup {
  item_group_id   Int     @id @default(autoincrement())
  item_group_name String? @db.VarChar(150)
}

model ItemSubFamily {
  item_subfamily_id Int     @id @default(autoincrement())
  item_family_id    Int?
  category_name1    String? @db.VarChar(150)
  category_name2    String? @db.VarChar(150)
  category_name3    String? @db.VarChar(150)
  category_name4    String? @db.VarChar(150)
  category_name5    String? @db.VarChar(150)
}

model Items {
  item_id                Int                      @id @default(autoincrement())
  item_cat_id            Int?
  item_name1             String?                  @db.VarChar(150)
  item_name2             String?                  @db.VarChar(150)
  item_name3             String?                  @db.VarChar(150)
  item_name4             String?                  @db.VarChar(150)
  item_name5             String?                  @db.VarChar(150)
  item_description1      String?                  @db.VarChar(150)
  item_description2      String?                  @db.VarChar(150)
  item_description3      String?                  @db.VarChar(150)
  item_description4      String?                  @db.VarChar(150)
  item_description5      String?                  @db.VarChar(150)
  item_image_url         String?                  @db.VarChar(150)
  item_type              String?                  @db.VarChar(45)
  item_price             String?                  @db.VarChar(45)
  reservation            String?                  @db.VarChar(1)
  checkin                String?                  @db.VarChar(1)
  room                   String?                  @db.VarChar(1)
  instantOrder           String?                  @db.VarChar(1)
  sendStaychat           String?                  @db.VarChar(1)
  staychatWebhook        String?                  @db.VarChar(255)
  visiblePrice           String?                  @db.VarChar(1)
  allowReservations      String?                  @db.VarChar(1)
  scheduleID             String?                  @db.VarChar(1)
  preparation            Json?
  item_vat               String?                  @db.VarChar(45)
  item_duration          Int?
  OutletItems            OutletItems[]
  OutletReservationItems OutletReservationItems[]
}

model OutletReservationItems {
  outlet_reservation_item_id Int     @id @default(autoincrement())
  outlet_id                  Int
  item_id                    Int
  shift_index                Int
  Items                      Items   @relation(fields: [item_id], references: [item_id], onDelete: Cascade, map: "fk_outlet_reservation_items_item")
  Outlets                    Outlets @relation(fields: [outlet_id], references: [outlet_id], onDelete: Cascade, map: "fk_outlet_reservation_items_outlet")

  @@index([outlet_id], map: "idx_outlet_reservation_items_outlet_id")
  @@index([item_id], map: "idx_outlet_reservation_items_item_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability {
  availability_id    BigInt     @id @default(autoincrement())
  typology_id        BigInt
  availability_date  DateTime   @db.Date
  start_time         DateTime   @db.Time(0)
  end_time           DateTime   @db.Time(0)
  total_capacity     Int
  available_capacity Int
  updated_at         DateTime   @default(now()) @db.Timestamp(0)
  typologies         typologies @relation(fields: [typology_id], references: [typology_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_availability_typologies")

  @@unique([typology_id, availability_date, start_time], map: "uq_availability_typology_date_start")
  @@index([availability_date, typology_id], map: "idx_availability_date_typology")
}

model typologies {
  typology_id  BigInt         @id @default(autoincrement())
  outlet_id    Int
  name         String         @db.VarChar(100)
  availability availability[]
  Outlets      Outlets        @relation(fields: [outlet_id], references: [outlet_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_typologies_outlets")

  @@unique([outlet_id, name], map: "uq_typologies_outlet_name")
}

model OutletItems {
  outlet_item_id      Int       @id @default(autoincrement())
  item_id             Int
  outlet_id           Int
  item_name1          String?   @db.VarChar(150)
  item_name2          String?   @db.VarChar(150)
  item_name3          String?   @db.VarChar(150)
  item_name4          String?   @db.VarChar(150)
  item_name5          String?   @db.VarChar(150)
  item_description1   String?   @db.VarChar(150)
  item_description2   String?   @db.VarChar(150)
  item_description3   String?   @db.VarChar(150)
  item_description4   String?   @db.VarChar(150)
  item_description5   String?   @db.VarChar(150)
  item_image_url      String?   @db.VarChar(150)
  item_type           String?   @db.VarChar(45)
  item_price          Decimal?  @db.Decimal(10, 2)
  reservation         String?   @db.VarChar(1)
  checkin             String?   @db.VarChar(1)
  room                String?   @db.VarChar(1)
  instantOrder        String?   @db.VarChar(1)
  sendStaychat        String?   @db.VarChar(1)
  staychatWebhook     String?   @db.VarChar(255)
  visiblePrice        String?   @db.VarChar(1)
  allowReservations   String?   @db.VarChar(1)
  scheduleID          String?   @db.VarChar(1)
  preparation         Json?
  created_at          DateTime? @default(now()) @db.Timestamp(0)
  updated_at          DateTime? @default(now()) @db.Timestamp(0)
  item_vat            String?   @db.VarChar(45)
  item_duration       Int?
  schedule_id         Int?
  shift_index         Int?
  is_reservation_item Boolean   @default(false)
  cart                Boolean   @default(false)
  takeaway_order      Boolean   @default(false)
  order               Boolean   @default(false)
  Items               Items     @relation(fields: [item_id], references: [item_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_outlet_items_item")

  @@index([item_id], map: "idx_outlet_items_item_id")
  @@index([outlet_id], map: "idx_outlet_items_outlet_id")
}
